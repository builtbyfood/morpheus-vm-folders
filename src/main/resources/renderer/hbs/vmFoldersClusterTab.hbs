<!-- VM Folders 1.5.10 — lazy tab shell (cluster detail page). Static: no data, no tab CSS, no request to /plugin/vmFolders/ until the tab is opened. vmFolders.js (vmfLazyInit) builds the rest. -->
<div id="vmf-lazy-cluster" data-server-id="{{serverId}}" data-server-name="{{serverName}}" data-cloud-name="{{cloudName}}" data-asset-version="{{assetVersion}}" data-load-mode="{{loadMode}}">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:8px 12px;font-size:12px;">
    <span class="vmf-lazy-status">Not loaded</span>
    <button type="button" class="btn btn-default btn-sm vmf-lazy-load">Load</button>
    <button type="button" class="btn btn-default btn-sm vmf-lazy-refresh" style="display:none">Refresh</button>
    <label style="margin:0 0 0 auto;font-weight:400;"><input type="checkbox" class="vmf-lazy-noauto"> Don't auto-load this tab</label>
  </div>
  <div class="vmf-lazy-body"></div>
</div>
<script nonce="{{nonce}}">
(function() {
  function go() {
    if (typeof window.vmfLazyInit === 'function') { window.vmfLazyInit('cluster'); return; }
    var st = document.querySelector('#vmf-lazy-cluster .vmf-lazy-status');
    if (st) st.textContent = 'VM Folders script is out of date in this browser - reload with Ctrl+F5.';
  }
  if (typeof window.vmfLazyInit === 'function') { go(); return; }
  var s = document.createElement('script');
  s.src = '/assets/plugin/vm-folders/vmFolders.js?v={{assetVersion}}';
  s.nonce = '{{nonce}}';
  s.onload = go;
  document.head.appendChild(s);
})();
</script>
